<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dirección de Envío"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Captura tu ubicación GPS o escribe tu dirección"
            android:textColor="#FF6D00"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"/>

        <!-- Visor GPS Interactivo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvGpsCoordinates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Coordenadas GPS: Sin capturar"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnGetGpsLocation"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Obtener Ubicación GPS Actual"
                android:textColor="#FF6D00"/>
        </LinearLayout>

        <!-- Campo de texto para dirección escrita -->
        <EditText
            android:id="@+id/etAddress"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="#1E1E1E"
            android:hint="Ej: Calle 80 # 94 - Bogotá / Funza"
            android:textColor="#FFFFFF"
            android:textColorHint="#777777"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="24dp"
            android:inputType="textPostalAddress"/>

        <!-- Botón para continuar al pago -->
        <Button
            android:id="@+id/btnProceedToPayment"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#FF6D00"
            android:text="Confirmar Dirección y Pagar"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>