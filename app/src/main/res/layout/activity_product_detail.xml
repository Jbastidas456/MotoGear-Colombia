<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Botón de Volver -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Volver al Catálogo"
            android:textColor="#FF6D00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Simulación de Imagen del Producto -->
        <View
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="#1E1E1E"
            android:layout_marginBottom="20dp"/>

        <!-- Título del Producto -->
        <TextView
            android:id="@+id/txtProductName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Casco Integral LS2 FF353"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Precio -->
        <TextView
            android:id="@+id/txtProductPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$ 480.000 COP"
            android:textColor="#FF6D00"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- Descripción -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descripción del producto:"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Casco aerodinámico con certificación internacional ECE 22.05. Interior desmontable y lavable, visor antirrayas preparado para Pinlock y sistema de ventilación superior e inferior."
            android:textColor="#B0B0B0"
            android:textSize="14sp"
            android:layout_marginBottom="32dp"/>

        <!-- Botón de Comprar / Agregar al Carrito -->
        <Button
            android:id="@+id/btnAddToCart"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#FF6D00"
            android:text="Agregar al Carrito"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>