<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Método de Pago"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Revisa tu resumen y selecciona cómo pagar"
            android:textColor="#FF6D00"
            android:textSize="14sp"
            android:layout_marginBottom="20dp"/>

        <!-- Resumen de la compra -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1E1E"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tvOrderSummaryTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total a Pagar: $ 0.0 COP"
                android:textColor="#FF6D00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:id="@+id/tvOrderSummaryAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Envío a: -"
                android:textColor="#CCCCCC"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Selector de método de pago -->
        <RadioGroup
            android:id="@+id/rgPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp">

            <RadioButton
                android:id="@+id/rbCardEpayco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E1E1E"
                android:padding="16dp"
                android:text="💳 Pasarela ePayco (Tarjeta / PSE)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:buttonTint="#FF6D00"
                android:checked="true"
                android:layout_marginBottom="12dp"/>

            <RadioButton
                android:id="@+id/rbCashOnDelivery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1E1E1E"
                android:padding="16dp"
                android:text="💵 Pago Contra Entrega (Efectivo)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:buttonTint="#FF6D00"/>
        </RadioGroup>

        <!-- Botón Finalizar Compra -->
        <Button
            android:id="@+id/btnConfirmOrder"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:backgroundTint="#FF6D00"
            android:text="Finalizar y Confirmar Pedido"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>