<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recuperar Contraseña"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ingresa tu correo electrónico registrado y te enviaremos instrucciones."
        android:textColor="#B0B0B0"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"/>

    <EditText
        android:id="@+id/etEmailRecovery"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#1E1E1E"
        android:hint="correo@ejemplo.com"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="20dp"
        android:inputType="textEmailAddress"/>

    <Button
        android:id="@+id/btnSendRecovery"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:backgroundTint="#FF6D00"
        android:text="Enviar Instrucciones"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/btnBackToLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="← Volver al Iniciar Sesión"
        android:textColor="#FF6D00"
        android:textSize="14sp"
        android:layout_gravity="center"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>